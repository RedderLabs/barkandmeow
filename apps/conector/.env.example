# Conector del software de gestión con Bark & Meow. Copia a .env y rellena.
# Este archivo lleva secretos de la clínica: no sale de la máquina donde corre.

# ── Bark & Meow ──────────────────────────────────────────────
# Se crean en la consola de la clínica, «Conexión del software de gestión».
# El token y la clave de firma solo se muestran una vez.
BM_API_URL=https://api.barkandmeow.app
BM_API_KEY=bmk_
BM_FIRMA=bmf_

# ── Qué programa lee (uno o varios) ──────────────────────────

# ezyVet: credenciales de partner (developers.ezyvet.com, «Apply»).
# EZYVET_URL=https://api.trial.ezyvet.com   para el entorno de pruebas
EZYVET_PARTNER_ID=
EZYVET_CLIENT_ID=
EZYVET_CLIENT_SECRET=
# Los scopes que tenga concedidos la integración, separados por comas.
# EZYVET_SCOPE=read-animal,read-consult,read-vaccination,read-history,read-product
# EZYVET_SITE_UID=
# Horas que se espera antes de enviar una consulta (para no mandar cada edición).
# EZYVET_ESPERA_HORAS=24

# Provet Cloud: https://provetcloud.com/<provet_id>, sin /api/0.1.
# Cliente OAuth 2.0 «client credentials» creado en Provet (Ajustes → Integraciones).
PROVET_URL=
PROVET_CLIENT_ID=
PROVET_CLIENT_SECRET=
# Solo instalaciones antiguas con token de API (retirado por Provet):
# PROVET_TOKEN=

# QVET: carpeta donde se guardan los listados exportados en CSV.
QVET_CARPETA=

# ── Funcionamiento ───────────────────────────────────────────
# CONECTOR_ESTADO=./estado-conector.json
# CONECTOR_INTERVALO_MIN=15
# Días hacia atrás que se leen la primera vez.
# CONECTOR_DIAS_INICIALES=30
# Zona horaria de las fechas de los registros (por defecto la del sistema).
# CONECTOR_ZONA=Europe/Madrid
# Reglas de validez de vacunas y columnas de QVET (ver reglas.ejemplo.json).
# CONECTOR_REGLAS=./reglas.json
# Qué nombres de producto o enfermedad cuentan como rabia (expresión regular).
# CONECTOR_PATRON_RABIA=rabi|rage|tollwut|raiva

# ── MODO_ALOJADO: apagado. No lo actives sin leer el README ──
# Alojado en Bark & Meow, el conector rompe el cifrado de extremo a extremo.
# MODO_ALOJADO=no
