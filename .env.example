# Variables de entorno de Bark & Meow. Plantilla: copia cada bloque a su archivo.
# Los valores son los de desarrollo; en producción TODOS los secretos cambian.

# ── apps/api/.env ─────────────────────────────────────────────
PORT=4601
LOG_LEVEL=info
DATABASE_URL=postgres://barkandmeow:barkandmeow_dev@127.0.0.1:5443/barkandmeow
# Una de las dos vías para el pepper del índice de chips:
#   desarrollo, en el mismo proceso (la API avisa en cada arranque)
CHIP_PEPPER_LOCAL=pepper_dev_no_usar_en_produccion
#   producción, servicio aislado en services/pepper
# PEPPER_URL=http://127.0.0.1:4600
# PEPPER_TOKEN=
VET_ORIGINS=http://localhost:4510,http://127.0.0.1:4510
SESSION_DAYS=30
LOOKUP_BUDGET_MS=120
# Clave de los tokens de aviso. Obligatoria en producción: la API se niega a
# firmarlos sin ella. Genera una con: openssl rand -base64 32
AVISO_SECRET=
# De qué saltos se cree X-Forwarded-For. Por defecto, solo del Caddy local.
# TRUST_PROXY=loopback
# Intentos de login por cuenta de clínica y minuto.
# LIMITE_LOGIN_CLINICA=10
# Altas de clínica por IP y minuto, e invitaciones por clínica y día.
# LIMITE_ALTAS_CLINICA=5
# LIMITE_INVITACIONES_DIA=20
# Correo (nodemailer por SMTP). Desarrollo: bandeja de pruebas de Mailtrap;
# usuario y contraseña en Email Testing → tu inbox → SMTP Settings.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bark & Meow <no-responder@barkandmeow.app>
# Producción: Resend. MAIL_FROM tiene que ser de un dominio verificado en Resend.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_...   (la API key)

# ── apps/vet/.env.local ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:4601
CLINIC_DEV_URL=http://127.0.0.1:4520

# ── infra (docker compose lee infra/.env) ─────────────────────
# POSTGRES_PASSWORD=barkandmeow_dev
# CHIP_PEPPER=pepper_dev_no_usar_en_produccion


# Backblaze B2 (S3-compatible)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=